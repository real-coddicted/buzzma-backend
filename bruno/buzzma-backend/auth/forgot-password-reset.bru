meta {
  name: Forgot Password - Reset
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/auth/forgot-password/reset
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "mobile": "9876543210",
    "answers": [
      { "questionId": 1, "answer": "Fluffy" },
      { "questionId": 2, "answer": "Springfield" },
      { "questionId": 3, "answer": "Toyota" }
    ],
    "newPassword": "newpassword123"
  }
}
